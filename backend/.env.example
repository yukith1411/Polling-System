# SQLite by default — zero setup. For Postgres, set e.g.
# DATABASE_URL="postgresql://user:password@localhost:5432/polling"
# and change `provider = "sqlite"` to `provider = "postgresql"` in prisma/schema.prisma
DATABASE_URL="file:./dev.db"

PORT=4000
FRONTEND_URL="http://localhost:5173"

JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="12h"

# OTP behavior
OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
STUDENT_COMMON_PASSWORD="kit@123"

# Email — leave EMAIL_MODE=console for local dev (OTPs print to the server log).
# Switch to EMAIL_MODE=smtp and fill these in to actually send email.
EMAIL_MODE="console"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Polling System <no-reply@example.com>"
